# crawlfq — 采集前沿调度与礼貌配额管制台（5 服务栈）
COMPOSE_PROJECT_NAME=crawlfq

# PostgreSQL 16
DB_NAME=crawlfq_db
DB_USER=crawlfq_user
DB_PASSWORD=crawlfq_pwd_2026

# JWT
JWT_SECRET=crawlfq_dev_jwt_secret_change_me_20261110
ACCESS_TOKEN_MINUTES=120

# 对外端口（宿主）
FRONTEND_PORT=18238
BACKEND_PORT=19238
DB_PORT=17738

# 运行时
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
RATE_LIMIT_WRITE_PER_MINUTE=240

# 算法 A：布隆过滤器（2^20 位、k=5，blake2b 派生）
BLOOM_BITS=1048576
BLOOM_K=5

# 算法 B：调度模拟默认参数（虚拟时钟，不真发网络请求）
SIM_WINDOW_S=20
SIM_MAX_SEQUENCE=40
SIM_SEED=7
ARTIFACT_DIR=/data/artifacts
TZ=Asia/Shanghai
